# Rafeeq Kernel — Local Development Overrides
# Copy to docker-compose.override.yml and customize

version: "3.9"

services:
  app:
    volumes:
      - .:/app
    environment:
      - DEBUG=true
      - ENVIRONMENT=development
    command: uvicorn api.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app

  postgres:
    ports:
      - "5433:5432"

  redis:
    ports:
      - "6380:6379"
